{
  "name": "geometry",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/geometry/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/geometry",
        "main": "libs/geometry/src/index.ts",
        "tsConfig": "libs/geometry/tsconfig.lib.json",
        "assets": [
          "libs/geometry/*.md",
          {
            "input": "libs/geometry/src/types",
            "glob": "**/*.d.ts",
            "output": "./types"
          }
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/geometry/jest.config.ts"
      }
    }
  }
}
